{
  "name": "crudjt",
  "version": "1.0.0-beta.7",
  "description": "Fast B-tree–backed token store for stateful sessions",
  "main": "index.js",
  "scripts": {
    "cargo-build": "cargo build --release --message-format=json-render-diagnostics > cargo.log",
    "postcargo-build": "neon dist < cargo.log",
    "install": "npm run cargo-build && npm run postcargo-build",
    "debug": "cargo build --message-format=json-render-diagnostics && neon dist < cargo.log",
    "test": "cargo test"
  },
  "author": "Vlad Akymov (v_akymov)",
  "license": "MIT",
  "devDependencies": {
    "@neon-rs/cli": "0.1.73"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "lru-cache": "^11.0.1",
    "msgpack-lite": "^0.1.26",
    "neon-cli": "^0.10.1"
  },
  "keywords": [
    "token",
    "session",
    "authentication",
    "authorization"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/crudjt/crudjt-javascript"
  },
  "engines": {
    "node": ">=18"
  }
}
